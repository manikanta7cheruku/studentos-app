# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored. Never commit real values.
# Rule enforced by tests/repo-hygiene.test.ts: any name containing KEY, SECRET, TOKEN,
# PASSWORD or DSN must stay empty in this file.
# R2 added the Supabase variables on Day 2. Sentry and PostHog come later.
# Local values: run `pnpm supabase status -o env` after `pnpm db:start`.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server only, ignores Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Used to hash emails, IP addresses and enrolment numbers.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_HASH_SECRET=
# Frontend API mocking: set to "enabled" to run MSW in development (serves contract sample fixtures)
# Show Continue with Google on the sign in page. Set to enabled only after Google is set up in Supabase
# (docs/PRODUCTION_SETUP.md, section Continue with Google).
NEXT_PUBLIC_GOOGLE_SIGNIN=disabled
# Sign in by email code. Leave it out (or enabled) locally. Set to disabled where no email sender is set up yet:
# the sign in page then shows the email form disabled with Coming soon, and Google is the way in.
NEXT_PUBLIC_EMAIL_SIGNIN=enabled
NEXT_PUBLIC_API_MOCKING=disabled
# Shared secret for the scheduler that calls POST /api/internal/maintenance (at least 24 characters).
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
